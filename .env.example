# Copy this file to .env and fill in real values.
# Generate secrets automatically with: node scripts/setup.js

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# AES-256-GCM key — 64 hex characters (32 bytes)
ENCRYPTION_KEY=your_64_char_hex_encryption_key_here

# HMAC-SHA256 key — 64 hex characters (32 bytes)
HMAC_KEY=your_64_char_hex_hmac_key_here

# JWT secret — at least 32 characters
JWT_SECRET=your_jwt_secret_here

# PostgreSQL connection string
DATABASE_URL=postgresql://wallet_user:password@localhost:5432/wallet_db
DATABASE_SSL=false

# BetterStack telemetry source token
BETTERSTACK_TOKEN=your_betterstack_source_token_here

# Paystack
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_CALLBACK_URL=https://yourdomain.com/api/v1/wallet/fund/callback

# Comma-separated list of additional allowed CORS origins (your admin panel URL etc.)
CORS_ORIGINS=https://admin.yourdomain.com

# ── Virtual Number Providers ──────────────────────────────────────────────────

# 5SIM (primary provider) — https://5sim.net
FIVESIM_API_KEY=your_5sim_api_key_here

# SMS-Man (fallback provider) — https://sms-man.com
# SMS-Activate shut down Dec 2024; SMS-Man uses the same API format
SMSMAN_API_KEY=your_smsman_api_key_here

# Pricing — applied to both providers
# NGN per 1 USD (update regularly to match the live rate)
USD_TO_NGN_RATE=1600
# Platform markup added on top of provider price (percentage, e.g. 10 = 10%)
NUMBER_MARKUP_PERCENT=10

# ── Docker (postgres container init) ─────────────────────────────────────────
# Used by docker-compose to initialise the postgres container
POSTGRES_DB=wallet_db
POSTGRES_USER=wallet_user
POSTGRES_PASSWORD=your_postgres_password_here
